generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  cognitoSub       String?  @unique @map("cognito_sub")
  name             String?
  signupRole       String?  @map("signup_role") // "coach" | "athlete" set once on welcome
  stripeCustomerId String?  @unique @map("stripe_customer_id") // for saved payment methods
  createdAt        DateTime @default(now()) @map("created_at")

  coachProfile              CoachProfile?
  athleteProfiles           AthleteProfile[]
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]
}

model CoachProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String   @map("display_name")
  sports                String[] @default([])
  serviceCities         String[] @default([]) @map("service_cities")
  bio                   String   @default("")
  hourlyRate            Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  verified              Boolean  @default(false)
  backgroundCheckComplete Boolean @default(false) @map("background_check_complete")
  credentials           Json?    @default("{}")
  avatarUrl                 String?  @map("avatar_url")
  phone                     String?  @db.Text
  stripeConnectAccountId    String?  @unique @map("stripe_connect_account_id")
  stripeOnboardingComplete  Boolean  @default(false) @map("stripe_onboarding_complete")
  assistantDisplayName     String?  @map("assistant_display_name")
  assistantPhoneNumber     String?  @map("assistant_phone_number")
  assistantCapabilities    Json?    @map("assistant_capabilities") // e.g. { "scheduling": true, "bookings": true }
  planId                   String?  @map("plan_id") // "starter" | "pro" | "elite"
  billingMode              String   @default("after_session") @map("billing_mode") // "upfront" | "after_session"
  feeMode                  String   @default("pass_to_athlete") @map("fee_mode") // "pass_to_athlete" | "coach_absorbs"
  groupRates               Json?    @map("group_rates") // e.g. {"1": 100, "2": 75, "3": 60}

  photos             CoachPhoto[]
  locations          CoachLocation[]
  serviceAreas       ServiceArea[]     @relation("CoachServiceAreas")
  availabilityRules  AvailabilityRule[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]         @relation("CoachBookings")
  reviews            Review[]
  invite             CoachInvite?
  coachAthletes     CoachAthlete[]    @relation("CoachAthletes")
  athleteInvites    CoachAthleteInvite[]
  phoneOptIns       CoachAthletePhoneOptIn[]
  favoritedBy       FavoriteCoach[]   @relation("FavoritedBy")

  @@map("coach_profiles")
}

model CoachLocation {
  id        String       @id @default(uuid())
  coachId  String       @map("coach_id")
  coach    CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name     String       @map("name")
  address  String       @db.Text
  notes    String?      @db.Text
  latitude Decimal?     @db.Decimal(10, 7)
  longitude Decimal?   @db.Decimal(10, 7)

  availabilitySlots AvailabilitySlot[]
  availabilityRules AvailabilityRule[]

  @@map("coach_locations")
}

model AthleteProfile {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String   @map("display_name")
  serviceCity String?  @map("service_city")
  avatarUrl   String?  @map("avatar_url")
  birthYear   Int?     @map("birth_year")
  sports      String[] @default([])
  level       String?
  phone       String?  @map("phone")
  createdAt   DateTime @default(now()) @map("created_at")

  serviceAreas      ServiceArea[]     @relation("AthleteServiceAreas")
  coachAssociations CoachAthlete[]    @relation("AthleteCoaches")
  bookings          Booking[]         @relation("AthleteBookings")
  reviews           Review[]
  favorites         FavoriteCoach[]   @relation("AthleteFavorites")

  @@map("athlete_profiles")
}

model CoachPhoto {
  id             String       @id @default(uuid())
  coachProfileId String       @map("coach_profile_id")
  coach          CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  url            String
  sortOrder      Int          @default(0) @map("sort_order")

  @@map("coach_photos")
}

model AvailabilityRule {
  id               String   @id @default(uuid())
  coachId          String   @map("coach_id")
  coach            CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  locationId       String?  @map("location_id")
  location         CoachLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  firstStartTime   DateTime @map("first_start_time")
  durationMinutes Int      @map("duration_minutes")
  recurrence      String   @default("weekly")
  endDate         DateTime @map("end_date")
  maxCapacity     Int      @default(1) @map("max_capacity")
  createdAt       DateTime @default(now()) @map("created_at")

  slots AvailabilitySlot[]

  @@map("availability_rules")
}

model AvailabilitySlot {
  id            String   @id @default(uuid())
  coachId       String   @map("coach_id")
  coach         CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  locationId    String?  @map("location_id")
  location      CoachLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ruleId        String?  @map("rule_id")
  rule          AvailabilityRule? @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  recurrence    String   @default("none")
  status        String   @default("available")
  maxCapacity   Int      @default(1) @map("max_capacity")
  allowPrivate  Boolean  @default(true) @map("allow_private")

  // Session-level fields (slot = session anchor)
  sessionStatus String   @default("available") @map("session_status")
  inviteCode    String?  @unique @map("slot_invite_code")
  lockedPrivate Boolean  @default(false) @map("slot_locked_private")

  bookings      Booking[]
  conversation  Conversation?

  @@map("availability_slots")
}

model Booking {
  id                    String   @id @default(uuid())
  athleteProfileId      String   @map("athlete_profile_id")
  athleteProfile        AthleteProfile @relation("AthleteBookings", fields: [athleteProfileId], references: [id], onDelete: Cascade)
  coachId               String   @map("coach_id")
  coach                 CoachProfile @relation("CoachBookings", fields: [coachId], references: [id], onDelete: Cascade)
  slotId                String   @map("slot_id")
  slot                  AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  message               String?  @db.Text
  status                String   @default("pending")
  amountCents           Int?     @map("amount_cents")
  currency              String   @default("usd")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  paymentStatus         String?  @map("payment_status")
  createdAt             DateTime @default(now()) @map("created_at")
  completedAt           DateTime? @map("completed_at")
  coachRecap            String?  @map("coach_recap") @db.Text

  // Group booking fields
  groupSize             Int      @default(1) @map("group_size")
  inviteCode            String?  @unique @map("invite_code")
  isGroupOrganizer      Boolean  @default(true) @map("is_group_organizer")
  groupBookingId        String?  @map("group_booking_id")
  groupBooking          Booking? @relation("GroupMembers", fields: [groupBookingId], references: [id])
  groupMembers          Booking[] @relation("GroupMembers")
  attended              Boolean  @default(true)
  lockedPrivate         Boolean  @default(false) @map("locked_private")

  review Review?

  @@map("bookings")
}

model Review {
  id               String   @id @default(uuid())
  bookingId        String   @unique @map("booking_id")
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coachId          String   @map("coach_id")
  coach            CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteProfileId String   @map("athlete_profile_id")
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model CoachInvite {
  id             String       @id @default(uuid())
  coachProfileId String       @unique @map("coach_profile_id")
  coach          CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  slug           String       @unique
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("coach_invites")
}

model CoachAthlete {
  id              String        @id @default(uuid())
  coachProfileId  String        @map("coach_profile_id")
  coach           CoachProfile  @relation("CoachAthletes", fields: [coachProfileId], references: [id], onDelete: Cascade)
  athleteProfileId String       @map("athlete_profile_id")
  athlete         AthleteProfile @relation("AthleteCoaches", fields: [athleteProfileId], references: [id], onDelete: Cascade)
  status          String        @default("active") // active | pending | blocked
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([coachProfileId, athleteProfileId])
  @@map("coach_athletes")
}

/// Pending email invitations sent by a coach to a person who isn't on Apex yet.
/// On signup-via-claim-link, this row is marked promoted and a real CoachAthlete is created.
model CoachAthleteInvite {
  id                       String       @id @default(uuid())
  coachProfileId           String       @map("coach_profile_id")
  coach                    CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  athleteEmail             String       @map("athlete_email") // stored lowercased
  athleteName              String       @map("athlete_name")
  parentName               String?      @map("parent_name")
  token                    String       @unique
  status                   String       @default("invited") // invited | promoted | cancelled
  invitedAt                DateTime     @default(now()) @map("invited_at")
  lastSentAt               DateTime     @default(now()) @map("last_sent_at")
  promotedAt               DateTime?    @map("promoted_at")
  promotedToCoachAthleteId String?      @map("promoted_to_coach_athlete_id")

  @@unique([coachProfileId, athleteEmail])
  @@map("coach_athlete_invites")
}

model CoachAthletePhoneOptIn {
  id             String       @id @default(uuid())
  coachProfileId String       @map("coach_profile_id")
  coach          CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  phoneE164      String       @map("phone_e164")
  optedInAt      DateTime     @default(now()) @map("opted_in_at")
  source         String       @default("sms_inbound") @map("source")

  @@unique([coachProfileId, phoneE164])
  @@map("coach_athlete_phone_opt_ins")
}

model ServiceArea {
  id               String          @id @default(uuid())
  label            String
  latitude         Decimal         @db.Decimal(10, 7)
  longitude        Decimal         @db.Decimal(10, 7)
  radiusMiles      Int             @default(15) @map("radius_miles")
  coachProfileId   String?         @map("coach_profile_id")
  coachProfile     CoachProfile?   @relation("CoachServiceAreas", fields: [coachProfileId], references: [id], onDelete: Cascade)
  athleteProfileId String?         @map("athlete_profile_id")
  athleteProfile   AthleteProfile? @relation("AthleteServiceAreas", fields: [athleteProfileId], references: [id], onDelete: Cascade)

  @@map("service_areas")
}

model FavoriteCoach {
  id               String         @id @default(uuid())
  athleteProfileId String         @map("athlete_profile_id")
  athlete          AthleteProfile @relation("AthleteFavorites", fields: [athleteProfileId], references: [id], onDelete: Cascade)
  coachProfileId   String         @map("coach_profile_id")
  coach            CoachProfile   @relation("FavoritedBy", fields: [coachProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([athleteProfileId, coachProfileId])
  @@map("favorite_coaches")
}

model Conversation {
  id        String   @id @default(uuid())
  type      String   @default("direct") // "direct" | "session" | "group"
  title     String?
  slotId    String?  @unique @map("slot_id")
  slot      AvailabilitySlot? @relation(fields: [slotId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id               String       @id @default(uuid())
  conversationId   String       @map("conversation_id")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String       @map("user_id")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt       DateTime?    @map("last_read_at")
  preferredChannel String       @default("email") @map("preferred_channel") // "email" | "sms" | "both"
  createdAt        DateTime     @default(now()) @map("created_at")

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String       @map("sender_user_id")
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  deliveryStatus Json?        @map("delivery_status")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("messages")
}
